        <register>
          <name>ODMA_Y_STRIDE</name>
          <description>DMA Engine: luma plane line stride.
Output is NV12: a full-resolution luma plane followed by an interleaved chroma plane at half height. [access=rw]</description>
          <addressOffset>0x3080</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xf00</resetValue>
          <fields>
            <field>
              <name>Y_STRIDE</name>
              <description>Luma Line Stride
Bytes from one luma line to the next; one byte per pixel, rounded up to the bus width. [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ODMA_UV_STRIDE</name>
          <description>DMA Engine: chroma plane line stride.
The chroma plane has half as many lines as the luma plane but the same number of bytes per line, since U and V are interleaved at half horizontal rate. [access=rw]</description>
          <addressOffset>0x3084</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xf00</resetValue>
          <fields>
            <field>
              <name>UV_STRIDE</name>
              <description>Chroma Line Stride
Bytes from one chroma line to the next. [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ODMA_BUF_FREE</name>
          <description>DMA Engine: output-buffer ownership. Software sets a free bit to make a buffer available; nothing is captured then. When the channel next output frame starts, hardware claims the head buffer, captures its bases, strides and that frame geometry, and clears the bit. Completion sets ODMA_BUF_DONE after both planes and all write responses retire. [access=w1s]</description>
          <addressOffset>0x3088</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <modifiedWriteValues>oneToSet</modifiedWriteValues>
          <fields>
            <field>
              <name>ODMA_BUF_FREE</name>
              <description>ODMA_BUF_FREE; documented width 8, implemented mask 0xf. [access=w1s]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToSet</modifiedWriteValues>
            </field>
          </fields>
        </register>
        <register>
          <name>ODMA_BUF_DONE</name>
          <description>DMA Engine: completed output buffers, sticky W1C. Set only after both planes and all AXI write responses retire. Clear DONE before returning a buffer through ODMA_BUF_FREE. [access=w1c]</description>
          <addressOffset>0x308c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <modifiedWriteValues>oneToClear</modifiedWriteValues>

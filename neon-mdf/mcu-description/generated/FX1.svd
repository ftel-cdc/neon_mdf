          <description>AWB: selected-zone sum of Bcell over qualified Bayer cells; read-only. [access=ro]</description>
          <addressOffset>0x2448</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>ZONE_SUM_B_L</name>
              <description>Zone Blue Sum, Low Word
Bits [31:0] of the zone's blue sum. [access=ro]</description>

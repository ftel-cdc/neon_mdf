        <register>
          <name>TUNE_MODE</name>
          <description>Stopped-and-drained profile-mode selection. Legacy mode retains local update rules but uses the v1.06/v1.07 numeric domain. [access=rw]</description>
          <addressOffset>0x800c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>ENABLE</name>
              <description>0 legacy; 1 extension. Change only after full pipeline drain with no leased statistics bank; otherwise rejected with MODE. Leaving profile mode after drain clears both seals, resident pins, active/pending state and bank-local payload readiness. [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TUNE_BANK</name>
          <description>Live programming/readback selector. Selecting a sealed, active, pending or referenced bank is legal. Only mutations of its protected contents are rejected with LOCKED. [access=rw]</description>
          <addressOffset>0x8010</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>VALUE</name>
              <description>Live programming/readback selector. Selecting a sealed, active, pending or referenced bank is legal. Only mutations of its protected contents are rejected with LOCKED. [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>

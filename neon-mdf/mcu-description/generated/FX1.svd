<?xml version='1.0' encoding='utf-8'?>
<device schemaVersion="1.3">
  <vendor>FTEL</vendor>
  <name>FX1</name>
  <version>VP_FX1_V3.0_ISP_1.07</version>
  <description>FX1 RISC-V trên VP_FX1_V3.0; ISP CSR v1.07. Map VP, chưa xác nhận map silicon. W1P=pulse, W1SC=self-clear; xem CSR trước khi ghi.</description>
  <addressUnitBits>8</addressUnitBits>
  <width>32</width>
  <peripherals>
    <peripheral>
      <name>ISP</name>
      <description>ISP FX1 CSR v1.07 + VP extension 0x20261109 (ISP-UPD-001/002/007); FX1 header is authoritative.</description>
      <baseAddress>0x11000000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x8c94</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>ISP</name>
        <value>3</value>
      </interrupt>
      <registers>
        <register>
          <name>COMMON_VER_DATE</name>
          <description>Fixed register-map revision date, BCD; not a build timestamp. [access=ro]</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x18102026</resetValue>
          <fields>
            <field>
              <name>YEAR</name>
              <description>Version Date - Year
Year, BCD.  Reads 0x2026 for the current map. [access=ro]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>MONTH</name>
              <description>Version Date - Month
Month, BCD. [access=ro]</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>DAY</name>
              <description>Version Date - Day
Day of month, BCD. [access=ro]</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>COMMON_VER_ID</name>
          <description>Pipeline programming ABI revision 1.07. Bayer RAW12 statistics, preset-only scaling, channel crop and wide CSC range arithmetic. [access=ro]</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x10007</resetValue>
          <fields>
            <field>
              <name>VERSION</name>
              <description>Pipeline ABI 0x00010007; no per-block revision registers. [access=ro]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>COMMON_CTRL</name>
          <description>COMMON: global pipeline control. ISP_EN enables pipeline operation; supported optional blocks also use their own enable controls. [access=mixed]</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>ISP_EN</name>
              <description>ISP Pipeline Enable
1 enables pipeline operation. Configure geometry and tuning first, then enable the pipeline before arming/enabling DMA so derived output geometry is valid. [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SOFT_RST</name>
              <description>Request group recovery: stop admission, drain bus/internal work, then 15-clock reset pulse. Poll COMMON_RECOVERY_STATUS.BUSY/DONE for completion; copy abort records before restart. Busy requests rejected with TUNE_ERROR.PENDING. [access=w1sc]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToSet</modifiedWriteValues>
            </field>
            <field>
              <name>FRAME_START</name>
              <description>Software Frame Trigger (compatibility)
Retained for register compatibility only. A write of 1 is accepted, self-clears and has no effect on the input DMA, admission or any other state. The input DMA starts a frame whenever its head buffer is valid; mark exactly one input buffer valid for single-shot operation. [access=w1s]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToSet</modifiedWriteValues>
            </field>
          </fields>
        </register>
        <register>
          <name>COMMON_STATUS</name>
          <description>COMMON: global pipeline status, read-only. [access=ro]</description>
          <addressOffset>0xc</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>BUSY</name>
              <description>Pipeline Busy
1 = a frame is in flight somewhere in the pipeline. [access=ro]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>FRAME_DONE</name>
              <description>Frame Complete
1 = the most recently admitted frame has retired on every enabled output, successfully or by recovery. Clears at the next accepted ingress SOF and on reset. [access=ro]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>ERROR</name>
              <description>Error Present
Live OR of DMA_ERR ALIGN/AXI_RD/AXI_WR, LSC_ERROR, EE_STATUS.ERROR and TUNE_ERROR; flow-control and statistics-drop conditions are excluded. See those registers for the cause. [access=ro]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>COMMON_IRQ_STATUS</name>
          <description>COMMON: interrupt status.  Sticky; write 1 to clear a bit.
A bit sets regardless of the corresponding COMMON_IRQ_EN mask -- the mask gates the interrupt output, not the status. [access=w1c]</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <modifiedWriteValues>oneToClear</modifiedWriteValues>
          <fields>
            <field>
              <name>FRAME_DONE_IRQ</name>
              <description>Frame-Done Interrupt Status
Set when COMMON_STATUS.FRAME_DONE rises.  Write 1 to clear. [access=w1c]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>ERROR_IRQ</name>
              <description>Error Interrupt Status
Set when DMA_ERR ALIGN, AXI_RD or AXI_WR, any LSC_ERROR bit, EE_STATUS.ERROR or any TUNE_ERROR bit changes from 0 to 1, and on every accepted recovery of any cause. IDMA_UNDERRUN, ODMA_OVERFLOW and statistics drops do not set it.  Write 1 to clear. [access=w1c]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>STATS_READY_IRQ</name>
              <description>Statistics-Ready Interrupt Status
Set when a statistics block publishes a completed frame.  Write 1 to clear. [access=w1c]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
          </fields>
        </register>
        <register>
          <name>COMMON_IRQ_EN</name>
          <description>COMMON: interrupt enable mask.
Each bit gates whether the matching COMMON_IRQ_STATUS bit drives the interrupt output; the status bit sets either way. [access=rw]</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>FRAME_DONE_EN</name>
              <description>Frame-Done Interrupt Enable
1 = frame-done contributes to the interrupt output. [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ERROR_EN</name>
              <description>Error Interrupt Enable
1 = error contributes to the interrupt output. [access=rw]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>STATS_READY_EN</name>
              <description>Statistics-Ready Interrupt Enable
1 = statistics-ready contributes to the interrupt output. [access=rw]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>COMMON_FRAME_WIDTH</name>
          <description>COMMON: input frame width before Bayer phase alignment. The Input Formatter may discard one leading column, then rounds the remaining width down to even. Program legal DMA geometry. Input-domain changes require stopped/drained legacy mode; reject in profile mode with MODE, preserve state. Accepted changes invalidate dependent LSC/EE residents and output geometry. [access=rw]</description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x780</resetValue>
          <fields>
            <field>
              <name>H_ACTIVE</name>
              <description>External Samples Per Line
Even external input width before Bayer phase trim, 32..3842. Active W=(Win-SH)&amp;~1 must be 32..3840. IDMA reads the external width; downstream coordinates use the derived active width. [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>COMMON_FRAME_HEIGHT</name>
          <description>COMMON: input frame height before Bayer phase alignment. The Input Formatter may discard one leading row, then rounds the remaining height down to even. Input DMA requires an even input height. Input-domain changes require stopped/drained legacy mode; reject in profile mode with MODE, preserve state. Accepted changes invalidate dependent LSC/EE residents and output geometry. [access=rw]</description>
          <addressOffset>0x1c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x438</resetValue>
          <fields>
            <field>
              <name>V_ACTIVE</name>
              <description>External Lines Per Frame
Even external input height before Bayer phase trim, 32..2162. Active H=(Hin-SV)&amp;~1 must be 32..2160. IDMA reads the external height; downstream coordinates use the derived active height. [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>COMMON_BAYER</name>
          <description>COMMON: Bayer phase of the incoming raw image. The Input Formatter aligns to RGGB by optional leading-column/row removal, then rounds each remaining dimension down to even. Input-domain changes require stopped/drained legacy mode; reject in profile mode with MODE, preserve state. Accepted changes invalidate dependent LSC/EE residents and output geometry. [access=rw]</description>
          <addressOffset>0x20</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>PATTERN</name>
              <description>Bayer Colour-Filter Pattern
Bits [1:0] = [vertical shift, horizontal shift].
0x0 = RGGB
0x1 = GRBG
0x2 = GBRG
0x3 = BGGR [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>COMMON_SCRATCH</name>
          <description>COMMON: scratch register, no hardware effect.
A plain 32-bit RW location, useful for proving the register bus is alive before trusting anything else read from it. [access=rw]</description>
          <addressOffset>0x28</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>SCRATCH</name>
              <description>Scratch Value
Reads back whatever was written. [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>BLC_CTRL</name>
          <description>BLC: black level correction control.
Subtracts the sensor's dark pedestal, then optionally rescales the remaining range so that full scale is restored. [access=rw]</description>
          <addressOffset>0x200</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>EN</name>
              <description>Black Level Correction Enable
1 = subtract the pedestal, 0 = pass through unchanged. [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>BLC_GAIN_SEL</name>
          <description>Select BLC profile G0..G7 (ISP-UPD-002). Apply per-channel scale of selected BLC profile; 0 selects unity. [access=rw]</description>
          <addressOffset>0x204</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x100</resetValue>
          <fields>
            <field>
              <name>GAIN_LEVEL</name>
              <description>Select BLC profile G0..G7 (ISP-UPD-002). [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RANGE_SCALE_EN</name>
              <description>Apply per-channel scale of selected BLC profile; 0 selects unity. [access=rw]</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>BLC_OFS_G0_DFT</name>
          <description>BLC: profile G0 shared pedestal.
Subtracted from every channel; the per-channel registers add a trim on top. [access=rw]</description>
          <addressOffset>0x208</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xc8</resetValue>
          <fields>
            <field>
              <name>OFS_G0_DFT</name>
              <description>Profile G0 Shared Black Level
Unsigned 12-bit Bayer code, 0..4095. The shared pedestal and selected channel trim are added exactly in 13 bits before subtraction, without wrap or saturation; the residual clamps at zero. Reset 200. [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>12</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>BLC_OFS_G0_R</name>
          <description>BLC: profile G0 red trim. [access=rw]</description>
          <addressOffset>0x20c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>OFS_G0_R</name>
              <description>Profile G0 Red Black Level Trim
Unsigned 12-bit Bayer code, 0..4095. The shared pedestal and selected channel trim are added exactly in 13 bits before subtraction, without wrap or saturation; the residual clamps at zero. Reset 0. [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>12</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>BLC_OFS_G0_GR</name>
          <description>BLC: profile G0 green-on-red-row trim. [access=rw]</description>
          <addressOffset>0x210</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>OFS_G0_GR</name>
              <description>Profile G0 Green-Red Black Level Trim
Unsigned 12-bit Bayer code, 0..4095. The shared pedestal and selected channel trim are added exactly in 13 bits before subtraction, without wrap or saturation; the residual clamps at zero. Reset 0. [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>12</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>BLC_OFS_G0_GB</name>
          <description>BLC: profile G0 green-on-blue-row trim. [access=rw]</description>
          <addressOffset>0x214</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>OFS_G0_GB</name>
              <description>Profile G0 Green-Blue Black Level Trim
Unsigned 12-bit Bayer code, 0..4095. The shared pedestal and selected channel trim are added exactly in 13 bits before subtraction, without wrap or saturation; the residual clamps at zero. Reset 0. [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>12</bitWidth>
              <access>read-write</access>
            </field>

          </fields>
        </register>
        <register>
          <name>FRAME_COUNTER</name>
          <description>DMA metadata time base: free-running 32-bit core-clock counter. Wraps modulo 2^32 (about 14.3 seconds at 300 MHz). [access=ro]</description>
          <addressOffset>0x3160</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>COUNTER</name>
              <description>Core-clock counter; hard-reset value zero. Capture and output SOF/EOF timestamps use this time base. Software must account for wrap and interpret differences within an unambiguous interval. [access=ro]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CH1_RESIZER_CTRL</name>
          <description>CH1 NV12 output resizer control, maximum output 3840x2160. Input is the post-IQ crop for this channel; the crop may be larger than the output. No upscaling or custom target sizes. Reject invalid targets before DMA arm; no silent FullRes fallback. Wait for channel OUT_W/H to settle. [access=rw]</description>
          <addressOffset>0x3200</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>EN</name>
              <description>CH1 resizer enable. 1 selects SCALE; 0 bypasses scaling and preserves crop size. Both paths must fit the 3840x2160 output limit. Change geometry only after stop/drain; validate before DMA arm. [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>UPDATED</name>
              <description>Legacy software update hint; readable storage with no commit effect. Active size, crop, enable and SCALE changes trigger geometry derivation. Custom-size words are reserved. Wait for OUT_W/H to settle before arming DMA; capture geometry at SOF. [access=rw]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SCALE</name>
              <description>CH1 NV12 preset selector [7:3]. 0=FullRes crop bypass; 1..14 established presets; 16=640x640, 17=640x384, 18=640x352, 19=512x512, 20=416x416, 21=320x320. Codes 15 and 22..31 reserved. Maximum output 3840x2160. Output must not exceed crop dimensions. No upscaling. [access=rw]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CH1_RESIZER_CUSTOM_W</name>
          <description>Deprecated target-size address. Reserved in ABI 1.07; reads zero and ignores writes. Programmable custom resizing is not supported. [access=ro]</description>
          <addressOffset>0x3204</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>RESERVED</name>
              <description>Reads zero; writes ignored. [access=ro]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CH1_RESIZER_CUSTOM_H</name>
          <description>Deprecated target-size address. Reserved in ABI 1.07; reads zero and ignores writes. Programmable custom resizing is not supported. [access=ro]</description>
          <addressOffset>0x3208</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>RESERVED</name>
              <description>Reads zero; writes ignored. [access=ro]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CH1_RESIZER_OUT_W</name>
          <description>Validated derived output dimension. Reset zero; may retain the last completed value while geometry is invalid. Check the channel GEOMETRY_STATUS before arming DMA. [access=ro]</description>
          <addressOffset>0x3214</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>OUT_WIDTH</name>
              <description>Validated derived output dimension. Reset zero; may retain the last completed value while geometry is invalid. Check the channel GEOMETRY_STATUS before arming DMA. [access=ro]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>13</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CH1_RESIZER_OUT_H</name>
          <description>Validated derived output dimension. Reset zero; may retain the last completed value while geometry is invalid. Check the channel GEOMETRY_STATUS before arming DMA. [access=ro]</description>
          <addressOffset>0x3218</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>OUT_HEIGHT</name>
              <description>Validated derived output dimension. Reset zero; may retain the last completed value while geometry is invalid. Check the channel GEOMETRY_STATUS before arming DMA. [access=ro]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>13</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CH1_RESIZER_STATUS</name>
          <description>RESIZER: block status. [access=ro]</description>
          <addressOffset>0x321c</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>BUSY</name>
              <description>Resizer Busy
1 = the resizer currently holds pixels. COMMON_STATUS.BUSY aggregates in-flight pipeline frames and output DMAs; this register is the per-channel view. [access=ro]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CH1_ODMA_Y_STRIDE</name>
          <description>DMA Engine: luma plane line stride.
Output is NV12: a full-resolution luma plane followed by an interleaved chroma plane at half height. [access=rw]</description>
          <addressOffset>0x3280</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xf00</resetValue>
          <fields>
            <field>
              <name>Y_STRIDE</name>
              <description>Luma Line Stride
Bytes from one luma line to the next; one byte per pixel, rounded up to the bus width. [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CH1_ODMA_UV_STRIDE</name>
          <description>DMA Engine: chroma plane line stride.
The chroma plane has half as many lines as the luma plane but the same number of bytes per line, since U and V are interleaved at half horizontal rate. [access=rw]</description>
          <addressOffset>0x3284</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xf00</resetValue>
          <fields>
            <field>
              <name>UV_STRIDE</name>
              <description>Chroma Line Stride
Bytes from one chroma line to the next. [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CH1_ODMA_BUF_FREE</name>
          <description>CH1: DMA Engine: output-buffer ownership. Software sets a free bit before use; hardware clears it when the output frame starts. Completion sets ODMA_BUF_DONE after both planes and all write responses retire. [access=w1s]</description>
          <addressOffset>0x3288</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <modifiedWriteValues>oneToSet</modifiedWriteValues>
          <fields>
            <field>
              <name>ODMA_BUF_FREE</name>
              <description>ODMA_BUF_FREE; documented width 8, implemented mask 0xf. [access=w1s]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToSet</modifiedWriteValues>
            </field>
          </fields>
        </register>
        <register>
          <name>CH1_ODMA_BUF_DONE</name>
          <description>CH1: DMA Engine: completed output buffers, sticky W1C. Set only after both planes and all AXI write responses retire. Clear DONE before returning a buffer through ODMA_BUF_FREE. [access=w1c]</description>
          <addressOffset>0x328c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <modifiedWriteValues>oneToClear</modifiedWriteValues>
          <fields>
            <field>
              <name>ODMA_BUF_DONE</name>
              <description>ODMA_BUF_DONE; documented width 8, implemented mask 0xf. [access=w1c]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
          </fields>
        </register>
        <register>
          <name>CH1_ODMA_FRAME_COUNT</name>
          <description>DMA Engine: frames written since reset, read-only.
Wait on this rather than on ODMA_BUF_DONE: the done bits are write-1-to-clear and shared with the previous acknowledge, while the counter only goes up. [access=ro]</description>
          <addressOffset>0x3290</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>ODMA_FRAME_COUNT</name>
              <description>Output Frame Counter
Output frame counter, wraps modulo 2^32. [access=ro]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CH1_ODMA_Y_ADDR_L0</name>
          <description>DMA Engine: luma buffer 0 base address, low word. [access=rw]</description>
          <addressOffset>0x32a0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>ODMA_Y_ADDR0_LO</name>
              <description>Luma Buffer 0 Address, Low Word
Bits [31:0] of the DDR address of the luma plane. [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CH1_ODMA_Y_ADDR_H0</name>
          <description>DMA Engine: luma buffer 0 base address, high word. [access=rw]</description>
          <addressOffset>0x32a4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>ODMA_Y_ADDR0_HI</name>
              <description>Luma Buffer 0 Address, High Word
Bits [63:32] of the DDR address. [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CH1_ODMA_UV_ADDR_L0</name>
          <description>DMA Engine: chroma buffer 0 base address, low word. [access=rw]</description>
          <addressOffset>0x32a8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>ODMA_UV_ADDR0_LO</name>
              <description>Chroma Buffer 0 Address, Low Word
Bits [31:0] of the DDR address of the chroma plane.
Independent of the luma address, so the two planes need not be contiguous. [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>

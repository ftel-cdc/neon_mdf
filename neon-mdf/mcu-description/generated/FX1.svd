        <register>
          <name>COMMON_RECOVERY_STATUS</name>
          <description>Live recovery status outside soft-reset domains. Read records only with BUSY=0 and a stable recovery sequence. [access=mixed]</description>
          <addressOffset>0x8c00</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>BUSY</name>
              <description>Recovery in progress. Do not re-arm DMA until zero. [access=ro]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>DONE</name>
              <description>Recovery completed; W1C, hardware set wins. Cleared by each accepted recovery. [access=w1c]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>SCOPE</name>
              <description>0 none; 1 DMA/automatic fault recovery; 2 common recovery; 3 reserved. [access=ro]</description>
              <bitOffset>4</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>PHASE</name>
              <description>0 idle, 1 bus/internal drain, 2 reset pulse, 3 final retirement. [access=ro]</description>
              <bitOffset>8</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>COUNT</name>
              <description>Valid abort-record prefix, 0..4 in ingress admission order. [access=ro]</description>
              <bitOffset>16</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>COMMON_RECOVERY_SEQUENCE</name>
          <description>Increments modulo 2^32 on each accepted recovery. Only hard reset clears this word. [access=ro]</description>
          <addressOffset>0x8c04</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>VALUE</name>
              <description>Recovery generation; recheck around record reads. [access=ro]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>COMMON_ABORT0_FRAME</name>
          <description>Captured ingress frame ID. Valid only within RECOVERY_STATUS.COUNT; unused records read zero. [access=ro]</description>
          <addressOffset>0x8c10</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>FRAME</name>
              <description>Immutable ingress sequence of an unretired context captured for recovery. [access=ro]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>COMMON_ABORT0_OUTCOME</name>
          <description>Aborted frame outcome, preserved until next recovery; only hard reset clears outside recovery. [access=ro]</description>
          <addressOffset>0x8c14</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>FAILED_OUTPUTS</name>
              <description>CH0/1/2 enabled outputs not successfully retired when recovery was captured. [access=ro]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>CAUSE</name>
              <description>1 read fault, 2 write fault, 3 DMA command, 4 common command, 5 malformed frame. Simultaneous read/write uses 1; sticky faults retain both. [access=ro]</description>
              <bitOffset>8</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-only</access>
            </field>
          </fields>

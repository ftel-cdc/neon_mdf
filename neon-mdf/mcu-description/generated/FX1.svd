        <register>
          <name>TUNE_ERROR</name>
          <description>Sticky error bits. Hardware set wins over W1C on the same edge.
Update: LIVE. MAS v1.07: tuning-profiles. [access=w1c]</description>
          <addressOffset>0x802c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <modifiedWriteValues>oneToClear</modifiedWriteValues>
          <fields>
            <field>
              <name>LOCKED</name>
              <description>Write, load or confirmation aimed at owned, sealed, pending or referenced storage. [access=w1c]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>INVALID</name>
              <description>Invalid field, geometry, table index or command, including a SEAL rule failure, a multi-command or EXACT-only TUNE_CMD write, an EXACT target exactly 2^31 ahead and APPLY of the already active bank. [access=w1c]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>NOT_READY</name>
              <description>APPLY of an unsealed bank, a SEAL whose required table is unconfirmed, or a failed table confirmation. [access=w1c]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>PENDING</name>
              <description>Second APPLY while pending, or software recovery request while COMMON_RECOVERY_STATUS.BUSY. Existing transaction continues. [access=w1c]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>MISSED</name>
              <description>EXACT target already past (d &gt; 2^31) at APPLY acceptance with an active profile; without an active profile INVALID is set instead. CANCEL and DMA recovery do not set MISSED. [access=w1c]</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>MODE</name>
              <description>Mode changed without drain, legacy command used in extension mode, profile command (TUNE_CMD, TUNE_TABLE_CMD) used in legacy mode, input-domain/IDLE-class write rejected because the pipeline was not idle or profile mode was active, or a TUNE_MODE change while a statistics bank is leased; state is preserved. [access=w1c]</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>NO_LEASE</name>
              <description>Result access without lease or duplicate lease operation. [access=w1c]</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>OVERFLOW</name>
              <description>A saturating result accumulator overflowed. [access=w1c]</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
          </fields>

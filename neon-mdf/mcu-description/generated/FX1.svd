        </register>
        <register>
          <name>CH2_RESIZER_CTRL</name>
          <description>CH2 AI RGB888 output resizer control, maximum output 640x640. Input is the post-IQ crop for this channel; the crop may be larger than the output. No upscaling or custom target sizes. Reject invalid targets before DMA arm; no silent FullRes fallback. Wait for channel OUT_W/H to settle. [access=rw]</description>
          <addressOffset>0x3400</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>EN</name>
              <description>CH2 resizer enable. 1 selects SCALE; 0 bypasses scaling and preserves crop size. Both paths must fit the 640x640 output limit. Change geometry only after stop/drain; validate before DMA arm. [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>UPDATED</name>
              <description>Legacy software update hint; readable storage with no commit effect. Active size, crop, enable and SCALE changes trigger geometry derivation. Custom-size words are reserved. Wait for OUT_W/H to settle before arming DMA; capture geometry at SOF. [access=rw]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SCALE</name>
              <description>CH2 AI RGB888 preset selector [7:3]. 0=FullRes crop bypass; 8=640x360; 14=640x480; 16=640x640; 17=640x384; 18=640x352; 19=512x512; 20=416x416; 21=320x320. All other codes invalid on CH2. FullRes crop must fit 640x640. Output must not exceed crop dimensions. No upscaling. [access=rw]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CH2_RESIZER_CUSTOM_W</name>
          <description>Deprecated target-size address. Reserved in ABI 1.07; reads zero and ignores writes. Programmable custom resizing is not supported. [access=ro]</description>
          <addressOffset>0x3404</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>RESERVED</name>
              <description>Reads zero; writes ignored. [access=ro]</description>

          <name>TUNE_PROFILE_ID</name>
          <description>Software profile identifier stored in the selected bank. Zero is allowed.
Update: PROFILE. MAS v1.07: tuning-profiles. [access=rw]</description>
          <addressOffset>0x8014</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>VALUE</name>
              <description>Software profile identifier stored in the selected bank. Zero is allowed. [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TUNE_APPLY_FRAME</name>
          <description>Exact target ingress frame sequence when EXACT=1; otherwise ignored.
Update: LIVE. MAS v1.07: tuning-profiles. [access=rw]</description>
          <addressOffset>0x8018</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>VALUE</name>
              <description>Exact target ingress frame sequence when EXACT=1; otherwise ignored. [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TUNE_CMD</name>
          <description>One command per write, except EXACT with APPLY; any other nonzero combination, including EXACT alone, executes nothing and sets INVALID. In legacy mode any nonzero write sets only MODE. SEAL validates but does not activate. UNSEAL permits edits only when inactive, nonpending and unreferenced. APPLY drains the old epoch before activation at an eligible ingress SOF. Check TUNE_STATUS/TUNE_ERROR after each command. [access=w1p]</description>
          <addressOffset>0x801c</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x0</resetValue>
          <modifiedWriteValues>oneToSet</modifiedWriteValues>
          <fields>
            <field>
              <name>INIT</name>
              <description>Initialize free bank-owned scalars from legacy state and extension defaults; invalidate bank-local payload readiness. Does not copy resident EE scalars, shared LSC mesh shape or live loader ports. [access=w1p]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
              <modifiedWriteValues>oneToSet</modifiedWriteValues>
            </field>
            <field>
              <name>SEAL</name>
              <description>Validate and seal selected bank including required tables. [access=w1p]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
              <modifiedWriteValues>oneToSet</modifiedWriteValues>
            </field>
            <field>
              <name>APPLY</name>
              <description>Snapshot pre-edge TUNE_BANK, selected bank ID and EXACT target. Pending first eligible next edge. Initial profile accepts NEXT or EXACT equal NEXT_FRAME only; farther target INVALID. A rejected APPLY changes nothing and sets one bit, first applicable of MODE, PENDING, NOT_READY (bank not sealed), INVALID, MISSED. [access=w1p]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
              <modifiedWriteValues>oneToSet</modifiedWriteValues>
            </field>
            <field>
              <name>CANCEL</name>
              <description>Cancel pending request before its ingress acceptance. With no pending request: no effect, no error. [access=w1p]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
              <modifiedWriteValues>oneToSet</modifiedWriteValues>
            </field>
            <field>
              <name>UNSEAL</name>
              <description>Unlock selected bank only when not active, referenced or pending. [access=w1p]</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
              <modifiedWriteValues>oneToSet</modifiedWriteValues>
            </field>
            <field>
              <name>EXACT</name>
              <description>Modifier on APPLY: require TUNE_APPLY_FRAME equality; otherwise next admitted SOF. [access=w1p]</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
              <modifiedWriteValues>oneToSet</modifiedWriteValues>
            </field>
          </fields>
        </register>
        <register>
          <name>TUNE_STATUS</name>
          <description>Coherent live controller status.
Update: LIVE. MAS v1.07: tuning-profiles. [access=ro]</description>
          <addressOffset>0x8020</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>ACTIVE_BANK</name>
              <description>Current ingress profile bank. [access=ro]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>ACTIVE_VALID</name>
              <description>First profile activated. [access=ro]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>PENDING</name>
              <description>An APPLY is pending. [access=ro]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>BANK0_BUSY</name>
              <description>Bank 0 active, referenced, sealed or pending. [access=ro]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>BANK1_BUSY</name>
              <description>Bank 1 active, referenced, sealed or pending. [access=ro]</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>BANK0_VALID</name>
              <description>Bank 0 sealed. [access=ro]</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>BANK1_VALID</name>
              <description>Bank 1 sealed. [access=ro]</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>BANK0_PENDING</name>
              <description>Bank 0 is the queued APPLY target. [access=ro]</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>BANK1_PENDING</name>
              <description>Bank 1 is the queued APPLY target. [access=ro]</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>BANK0_REFERENCED</name>
              <description>An outstanding frame references bank 0. [access=ro]</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>BANK1_REFERENCED</name>
              <description>An outstanding frame references bank 1. [access=ro]</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TUNE_ACTIVE_ID</name>
          <description>Profile of the latest admitted ingress frame; not a substitute for per-frame metadata.
Update: LIVE. MAS v1.07: tuning-profiles. [access=ro]</description>
          <addressOffset>0x8024</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>VALUE</name>
              <description>Profile of the latest admitted ingress frame; not a substitute for per-frame metadata. [access=ro]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>

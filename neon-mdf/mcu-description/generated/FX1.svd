        <register>
          <name>BLC_OFS_G0_B</name>
          <description>BLC: profile G0 blue trim. [access=rw]</description>
          <addressOffset>0x218</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>OFS_G0_B</name>
              <description>Profile G0 Blue Black Level Trim
Unsigned 12-bit Bayer code, 0..4095. The shared pedestal and selected channel trim are added exactly in 13 bits before subtraction, without wrap or saturation; the residual clamps at zero. Reset 0. [access=rw]</description>
              <bitOffset>0</bitOffset>

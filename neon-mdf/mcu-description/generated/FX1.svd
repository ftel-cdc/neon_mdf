        </register>
        <register>
          <name>AWB_ZONE_COUNT</name>
          <description>AWB: qualified Bayer-cell count for the selected zone, read-only. [access=ro]</description>
          <addressOffset>0x244c</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>ZONE_COUNT</name>
              <description>Qualified-cell count for the selected zone; one increment per accepted cell. [access=ro]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>23</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>AWB_STATUS</name>
          <description>AWB: sticky completion-event status. Completion does not grant read ownership; acquire the READY bank using AWB_RESULT_CTRL before reading results. [access=w1c]</description>
          <addressOffset>0x2450</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <modifiedWriteValues>oneToClear</modifiedWriteValues>
          <fields>
            <field>
              <name>STAT_DONE</name>
              <description>Statistics Ready
W1C event set when a complete result bank becomes READY. Clearing it neither acquires nor releases a bank. A simultaneous completion wins over clear. Poll READY_COUNT to detect queued results independently of this event. [access=w1c]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
          </fields>
        </register>
        <register>
          <name>AWB_UNDEREXPOSED_LIMIT</name>
          <description>AWB: strict lower qualification limit in 12-bit post-BPC Bayer code units. A cell is rejected if any of its four samples is &lt;= this value. [access=rw]</description>
          <addressOffset>0x2454</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>UNDEREXPOSED_LIMIT</name>
              <description>12-bit raw Bayer limit; all four cell samples must be strictly greater. [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>12</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>AWB_SATURATION_LIMIT</name>
          <description>AWB: strict upper qualification limit in 12-bit post-BPC Bayer code units. A cell is rejected if any of its four samples is &gt;= this value. [access=rw]</description>
          <addressOffset>0x2458</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xfff</resetValue>
          <fields>
            <field>
              <name>SATURATION_LIMIT</name>
              <description>12-bit raw Bayer limit; all four cell samples must be strictly less. [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>12</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>AWB_CONTEXT_ID</name>
          <description>AWB: illumination/color-control software context captured at ingress SOF with the frame configuration. [access=rw]</description>
          <addressOffset>0x245c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>CONTEXT_ID</name>
              <description>Opaque software context captured at ingress SOF and published with that frame result. [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>AWB_RESULT_CONTEXT_ID</name>
          <description>AWB: AWB_CONTEXT_ID captured with the immutable ingress-SOF statistics configuration, read-only. [access=ro]</description>
          <addressOffset>0x2460</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>CONTEXT_ID</name>
              <description>AWB_CONTEXT_ID captured at ingress SOF for the frame whose result is leased. [access=ro]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>AWB_FRAME_ID</name>
          <description>AWB: ingress frame identifier of the leased result bank, read-only. [access=ro]</description>
          <addressOffset>0x2464</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>FRAME_ID</name>
              <description>Shared ingress-SOF frame number of the leased statistics. First admitted frame after hard reset is 1; wraps modulo 2^32. Common and DMA soft resets preserve the counter. Metadata remains stable until RELEASE; no lease returns zero and sets the ownership error. [access=ro]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>AWB_RESULT_CTRL</name>
          <description>AWB: one-clock write-one ownership/report commands, qualified by byte strobes. Reads return zero; reserved bits are ignored. RELEASE wins over simultaneous ACQUIRE. New loss events win over CLEAR_REPORT. [access=w1p]</description>
          <addressOffset>0x2468</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x0</resetValue>
          <modifiedWriteValues>oneToSet</modifiedWriteValues>
          <fields>
            <field>
              <name>ACQUIRE</name>
              <description>Acquire the oldest READY bank for software readout. One-clock command; reads zero. No effect if no READY result or a lease already exists. Confirm READ_VALID before reading; allow one clock before zone reads. [access=w1p]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
              <modifiedWriteValues>oneToSet</modifiedWriteValues>
            </field>
            <field>
              <name>RELEASE</name>
              <description>Release the LEASED bank to FREE. One-clock command; reads zero. No effect without a lease. A released bank is eligible for admission on the following edge. [access=w1p]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
              <modifiedWriteValues>oneToSet</modifiedWriteValues>
            </field>
            <field>
              <name>CLEAR_REPORT</name>
              <description>Clear OVERRUN and DROP_COUNT only. One-clock command; reads zero. Does not release results or clear STAT_DONE. A simultaneous new loss sets OVERRUN and increments the cleared count. [access=w1p]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
              <modifiedWriteValues>oneToSet</modifiedWriteValues>
            </field>
          </fields>
        </register>
        <register>
          <name>AWB_RESULT_STATUS</name>
          <description>AWB: ownership status. Two result banks; at most one lease. Ready/leased banks are immutable. All reserved bits read zero. [access=ro]</description>
          <addressOffset>0x246c</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>READY_COUNT</name>
              <description>Number of complete READY banks, 0..2. [access=ro]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>LEASED</name>
              <description>1 when software holds a result bank. [access=ro]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>READ_VALID</name>
              <description>Equals LEASED; result reads return zero when clear. [access=ro]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>READ_BANK</name>
              <description>Index of leased result bank; zero without a lease. [access=ro]</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>WRITE_BUSY</name>
              <description>1 while a bank is WRITING, including final accumulation drain. [access=ro]</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>OVERRUN</name>
              <description>Sticky report for bank exhaustion, illegal geometry or ingress-context overflow. No new interrupt; clear with CLEAR_REPORT. [access=ro]</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>READ_NUM_ZONE_X</name>
              <description>Horizontal grid count captured with the leased bank; zero without a lease. [access=ro]</description>
              <bitOffset>8</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>READ_NUM_ZONE_Y</name>
              <description>Vertical grid count captured with the leased bank; zero without a lease. [access=ro]</description>
              <bitOffset>16</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>AWB_DROP_COUNT</name>
          <description>AWB: number of lost enabled measurements. Disabled frames do not increment. Count each lost measurement once; simultaneous distinct losses both count. [access=ro]</description>
          <addressOffset>0x2470</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>DROP_COUNT</name>
              <description>Saturating 32-bit count, maximum 0xFFFFFFFF. Clears on hard/common soft reset or CLEAR_REPORT. DMA-only reset preserves reporting. [access=ro]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>AF_CTRL</name>
          <description>AF: auto-focus statistics control.
Only the enable is implemented -- the block measures a focus score per zone. The search and VCM fields below have no hardware behind them. [access=mixed]</description>
          <addressOffset>0x2600</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>EN</name>
              <description>AF Statistics Enable
1 = accumulate focus statistics, 0 = idle. [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>BYPASS</name>
              <description>AF Bypass (not implemented)
No hardware behind this bit (feature absent); use EN. [access=rw]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>REG_UPDATE</name>
              <description>Configuration Commit (not implemented)
Reserved; no processing effect in this MAS. [access=rw]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SEARCH_START</name>
              <description>Start Focus Search (not implemented)
No hardware behind this bit (feature absent): there is no search engine. [access=w1s]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToSet</modifiedWriteValues>
            </field>
            <field>
              <name>SEARCH_ABORT</name>
              <description>Abort Focus Search (not implemented)
Reserved; no processing effect in this MAS. [access=w1s]</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToSet</modifiedWriteValues>
            </field>
            <field>
              <name>LUT_EN</name>
              <description>Position LUT Enable (not implemented)
Reserved; no processing effect in this MAS. [access=rw]</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>METRIC_SEL</name>
              <description>Focus Metric Select (not implemented)
No hardware behind this field (feature absent): the block computes one focus metric, which is not selectable. [access=rw]</description>
              <bitOffset>6</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>VCM_ACK</name>
              <description>VCM Acknowledge (not implemented)
Reserved; no processing effect in this MAS. [access=rw]</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>AF_ZONE_EN</name>
          <description>AF: focus zone mask (not implemented).
The frame is divided into a 4x4 grid of zones; all sixteen zones always contribute. [access=rw]</description>
          <addressOffset>0x2604</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xffff</resetValue>
          <fields>
            <field>
              <name>ZONE_EN</name>
              <description>Focus Zone Enable Mask
(not implemented) No hardware behind this field; every zone is measured.
One bit per focus zone, 4x4 grid in raster order.
Reset enables all sixteen.
bit 0 = ZONE_0 (Row 0, column 0)
bit 1 = ZONE_1 (Row 0, column 1)
bit 2 = ZONE_2 (Row 0, column 2)
bit 3 = ZONE_3 (Row 0, column 3)
bit 4 = ZONE_4 (Row 1, column 0)
bit 5 = ZONE_5 (Row 1, column 1)
bit 6 = ZONE_6 (Row 1, column 2)
bit 7 = ZONE_7 (Row 1, column 3)
bit 8 = ZONE_8 (Row 2, column 0)
bit 9 = ZONE_9 (Row 2, column 1)
bit 10 = ZONE_10 (Row 2, column 2)
bit 11 = ZONE_11 (Row 2, column 3)
bit 12 = ZONE_12 (Row 3, column 0)
bit 13 = ZONE_13 (Row 3, column 1)
bit 14 = ZONE_14 (Row 3, column 2)
bit 15 = ZONE_15 (Row 3, column 3) [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>AF_METRIC_CFG</name>
          <description>AF_METRIC_CFG: reserved autofocus search/lens-control field. This MAS provides per-zone focus measurements only; lens movement and search are software functions. [access=rw]</description>
          <addressOffset>0x2608</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>MIN_SCORE</name>
              <description>Minimum Valid Focus Score (not implemented)
Reserved; no processing effect in this MAS. [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SETTLE_FRAMES</name>
              <description>VCM Settling Frames (not implemented)
Reserved; no processing effect in this MAS. [access=rw]</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>AF_STAT_ADDR</name>
          <description>AF: which zone AF_STAT_DATA reports. [access=rw]</description>
          <addressOffset>0x260c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>ZONE_ADDR</name>
              <description>Readout Zone Select
Zone index 0..15, raster order. [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>AF_STAT_DATA</name>
          <description>AF: low 32 bits of the selected focus sum from the leased result bank. Use the 64-bit port when the full value is needed. Higher scores indicate more local detail, not an absolute focus distance. [access=ro]</description>
          <addressOffset>0x2610</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>FOCUS_SCORE</name>
              <description>Zone Focus Score
Low 32 bits of the authoritative 64-bit focus sum selected by AF_STAT_ADDR. ACQUIRE before reading and RELEASE after copying; no lease returns zero and sets NO_LEASE. [access=ro]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>AF_LUT_ADDR</name>
          <description>AF_LUT_ADDR: reserved autofocus search/lens-control field. This MAS provides per-zone focus measurements only; lens movement and search are software functions. [access=rw]</description>
          <addressOffset>0x2614</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>LUT_ADDR</name>
              <description>Position LUT Index (not implemented)
Reserved; no processing effect in this MAS. [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>AF_LUT_DATA</name>
          <description>AF_LUT_DATA: reserved autofocus search/lens-control field. This MAS provides per-zone focus measurements only; lens movement and search are software functions. [access=rw]</description>
          <addressOffset>0x2618</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>VCM_POSITION</name>
              <description>Position LUT Data (not implemented)
Reserved; no processing effect in this MAS. [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>AF_VCM_CUR_POS</name>
          <description>AF_VCM_CUR_POS: reserved autofocus search/lens-control field. This MAS provides per-zone focus measurements only; lens movement and search are software functions. [access=rw]</description>
          <addressOffset>0x261c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>VCM_CUR_POS</name>
              <description>Current VCM Position (not implemented)
Reserved; no processing effect in this MAS.  Software that drives a VCM itself can still use it as a scratch tag. [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>AF_VCM_BEST_POS</name>
          <description>AF_VCM_BEST_POS: reserved autofocus search/lens-control field. This MAS provides per-zone focus measurements only; lens movement and search are software functions. [access=ro]</description>
          <addressOffset>0x2620</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>VCM_BEST_POS</name>
              <description>Best VCM Position (not implemented)
Reserved; no processing effect in this MAS. [access=ro]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>AF_PEAK_SCORE</name>
          <description>AF_PEAK_SCORE: reserved autofocus search/lens-control field. This MAS provides per-zone focus measurements only; lens movement and search are software functions. [access=ro]</description>
          <addressOffset>0x2624</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>PEAK_SCORE</name>
              <description>Peak Focus Score (not implemented)
Reserved; no processing effect in this MAS. [access=ro]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>AF_FOCUS_RANGE</name>
          <description>AF_FOCUS_RANGE: reserved autofocus search/lens-control field. This MAS provides per-zone focus measurements only; lens movement and search are software functions. [access=rw]</description>
          <addressOffset>0x2628</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>ACCEPT_DELTA</name>
              <description>Acceptable Focus Delta (not implemented)
Reserved; no processing effect in this MAS. [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>HOF_RANGE</name>
              <description>Hyperfocal Range (not implemented)
Reserved; no processing effect in this MAS. [access=rw]</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>AF_STATUS</name>
          <description>AF: measurement status. BUSY reports in-flight accumulation, FRAME_DONE is a sticky W1C completion event, and SCORE_VALID identifies published scores. Search-related fields are reserved. [access=mixed]</description>
          <addressOffset>0x262c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>BUSY</name>
              <description>AF Statistics Busy
1 = a frame is being accumulated. [access=ro]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>FRAME_DONE</name>
              <description>Focus Scores Ready
Set when a frame's focus scores are complete.  Write 1 to clear. [access=w1c]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>SEARCH_DONE</name>
              <description>Search Complete (not implemented)
Reserved; no processing effect in this MAS. [access=w1c]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>VCM_POS_VALID</name>
              <description>VCM Position Valid (not implemented)
Reserved; no processing effect in this MAS. [access=w1c]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>SCORE_VALID</name>
              <description>Focus Scores Valid
1 = the published scores are from a completed frame. [access=ro]</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>AF_CONTEXT_ID</name>
          <description>AF: software lens-position context tag captured with the completed statistics frame. [access=rw]</description>
          <addressOffset>0x2630</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>CONTEXT_ID</name>
              <description>Statistics Context Tag
Arbitrary software value, captured with the frame that is measured next.
Exposure and lens changes take effect some frames after they are requested, so the tag is how software tells which request a result belongs to: write it here before the frame it describes, and read it back from AF_RESULT_CONTEXT_ID alongside that frame's statistics. [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>AF_RESULT_CONTEXT_ID</name>
          <description>AF: software context tag published with the leased statistics frame; stable until RELEASE. [access=ro]</description>
          <addressOffset>0x2634</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>CONTEXT_ID</name>
              <description>Captured Statistics Context Tag
AF_CONTEXT_ID captured at ingress for the leased statistics frame. Stable until RELEASE, including when another frame completes. No lease returns zero and sets NO_LEASE. [access=ro]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>AF_FRAME_ID</name>
          <description>AF: ingress frame identifier of the leased result bank, read-only. [access=ro]</description>
          <addressOffset>0x2638</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>FRAME_ID</name>
              <description>Shared ingress-SOF frame number of the leased statistics. First admitted frame after hard reset is 1; wraps modulo 2^32. Common and DMA soft resets preserve the counter. Metadata remains stable until RELEASE; no lease returns zero and sets the ownership error. [access=ro]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>OFMT_CTRL</name>
          <description>Output Formatter control. In the integrated core the formatter padding input is tied to zero: STRIDE_EN, OFMT_Y_STRIDE and OFMT_UV_STRIDE are readable storage with no effect, and ODMA alone applies the line stride. [access=rw]</description>
          <addressOffset>0x2800</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>STRIDE_EN</name>
              <description>Line Stride Padding Enable
Storage only in the integrated core; lines are always emitted packed and the ODMA applies the stride. Padding up to OFMT_Y_STRIDE / OFMT_UV_STRIDE is a standalone formatter capability. [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>OFMT_Y_STRIDE</name>
          <description>Output Formatter: luma line stride in bytes.
Storage only in the integrated core (see OFMT_CTRL). [access=rw]</description>
          <addressOffset>0x2804</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xf00</resetValue>
          <fields>
            <field>
              <name>Y_STRIDE</name>
              <description>Luma Line Stride
Bytes from one luma line to the next, one byte per pixel. A value at or below the active width emits no padding. [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>OFMT_UV_STRIDE</name>
          <description>Output Formatter: chroma line stride in bytes.
Storage only in the integrated core (see OFMT_CTRL). [access=rw]</description>
          <addressOffset>0x2808</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xf00</resetValue>
          <fields>
            <field>
              <name>UV_STRIDE</name>
              <description>Chroma Line Stride
Bytes from one chroma line to the next. Padding is emitted as 16-bit beats, so an odd byte count rounds down. [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DMA_CTRL</name>
          <description>DMA Engine: control at byte offset 0x3000. Configure and enable the pixel pipeline before arming/enabling DMA so output geometry is valid. DMA and CSR transactions are independent. [access=mixed]</description>
          <addressOffset>0x3000</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x3f00</resetValue>
          <fields>
            <field>
              <name>IDMA_EN</name>
              <description>Input DMA Enable
1 = the input DMA fetches frames from DDR. [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ODMA_EN</name>
              <description>Output DMA Enable
1 = the output DMA writes frames to DDR. [access=rw]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SOFT_RESET</name>
              <description>DMA Soft Reset
Request DMA-scope group recovery: stop admission, drain both AXI masters, held requests and internal consumers, then 15-clock internal reset pulse; reads zero. Preserves CSR configuration, the sealed active profile, completed READY/LEASED statistics and the DONE bits and metadata of outputs completed before the request. Preserves DMA_ERR and DMA_IRQ_STAT. Clears VALID/FREE ownership and restarts every rotation at buffer 0. Poll COMMON_RECOVERY_STATUS.BUSY/DONE; copy abort records before restart. Busy requests rejected with TUNE_ERROR.PENDING. COMMON_CTRL.SOFT_RST has the broader pipeline/result reset scope. [access=w1sc]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToSet</modifiedWriteValues>
            </field>
            <field>
              <name>MAX_BURST_M1</name>
              <description>Maximum AXI Burst Length Minus One
Encoded value 0..255 gives 1..256 beats. Reset 63 gives 64 beats. MAX_BURST_BEATS in the MAS is the effective value MAX_BURST_M1+1; bursts also split at line and 4 KiB boundaries. [access=rw]</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DMA_STAT</name>
          <description>DMA Engine: engine status, read-only.
Both bits read 0 on a wedged engine as well as an idle one, so do not treat 0 here as proof the engine is healthy -- check the frame counters advance. [access=ro]</description>
          <addressOffset>0x3004</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>IDMA_BUSY</name>
              <description>Input DMA Busy
1 = the input DMA has a transfer outstanding. [access=ro]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>ODMA_BUSY</name>
              <description>Output DMA Busy
1 = the output DMA has a transfer outstanding. [access=ro]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DMA_ERR</name>
          <description>DMA Engine: sticky error flags.  Write 1 to clear.
Sticky so a fault that occurred mid-frame survives until software looks. [access=w1c]</description>
          <addressOffset>0x3008</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <modifiedWriteValues>oneToClear</modifiedWriteValues>
          <fields>
            <field>
              <name>ERR</name>
              <description>ERR; documented width 6, implemented mask 0x1f. [access=w1c]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
          </fields>
        </register>
        <register>
          <name>DMA_IRQ_EN</name>
          <description>DMA Engine: interrupt enable mask.
Gates which DMA_IRQ_STAT bits reach the interrupt output; the status bits set regardless. [access=rw]</description>
          <addressOffset>0x300c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>IRQ_EN</name>
              <description>DMA Interrupt Enable Mask
Mask gates the interrupt output, not sticky status.
Bit 0 CFG_ERROR (illegal start configuration). Bit 1 IDMA_START. Bit 2 IDMA_DONE. Bit 3 IDMA_UNDERRUN. Bit 4 ODMA_DONE. Bit 5 ODMA_OVERFLOW. Bit 6 AXI_ERROR (either master). [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DMA_IRQ_STAT</name>
          <description>DMA Engine: sticky interrupt status.  Write 1 to clear. [access=w1c]</description>
          <addressOffset>0x3010</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <modifiedWriteValues>oneToClear</modifiedWriteValues>
          <fields>
            <field>
              <name>IRQ</name>
              <description>DMA Interrupt Status Flags
Sticky W1C; hardware set wins over simultaneous clear. DMA-scope recovery, automatic or commanded, preserves these bits; only W1C, common recovery and hard reset clear them.
Bit 0 CFG_ERROR (illegal start configuration). Bit 1 IDMA_START. Bit 2 IDMA_DONE. Bit 3 IDMA_UNDERRUN. Bit 4 ODMA_DONE. Bit 5 ODMA_OVERFLOW. Bit 6 AXI_ERROR (either master). [access=w1c]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
          </fields>
        </register>
        <register>
          <name>IDMA_STRIDE</name>
          <description>DMA Engine: input line stride in bytes. Must be at least 2*input_width and aligned to the AXI bus-byte width. Input bases are aligned to the same width; Bayer crop origin X is a multiple of bus_bytes/2 pixels and Y is even. [access=rw]</description>
          <addressOffset>0x3020</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x1e00</resetValue>
          <fields>
            <field>
              <name>IDMA_STRIDE</name>
              <description>Input Line Stride
Bytes between input lines. Reset 7680 bytes, sufficient for 3840 pixels at 2 bytes each; larger than the reset 1920-pixel line payload. [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>IDMA_BUF_VALID</name>
          <description>DMA Engine: input buffer ownership.
Four buffers rotate between software and hardware.  Software sets a bit to hand a filled buffer to the engine; the engine clears it when it has read the buffer and software may refill it. [access=w1s]</description>
          <addressOffset>0x3024</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <modifiedWriteValues>oneToSet</modifiedWriteValues>
          <fields>
            <field>
              <name>IDMA_BUF_VALID</name>
              <description>IDMA_BUF_VALID; documented width 8, implemented mask 0xf. [access=w1s]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToSet</modifiedWriteValues>
            </field>
          </fields>
        </register>
        <register>
          <name>IDMA_FRAME_COUNT</name>
          <description>DMA Engine: frames fetched since reset, read-only.
The reliable way to wait for a frame: it only ever increases, so it cannot be missed the way a level or an interrupt can. [access=ro]</description>
          <addressOffset>0x3028</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>IDMA_FRAME_COUNT</name>
              <description>Input Frame Counter
Input frame counter, wraps modulo 2^32. [access=ro]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>IDMA_BUF_ADDR_L0</name>
          <description>DMA Engine: input buffer 0 base address, low word. [access=rw]</description>
          <addressOffset>0x3040</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>IDMA_BUF_ADDR0_LO</name>
              <description>Input Buffer 0 Address, Low Word
Bits [31:0] of the DDR address of the buffer's first pixel.
Offsetting this within a larger image, together with IDMA_STRIDE, is how a crop window is expressed. [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>IDMA_BUF_ADDR_H0</name>
          <description>DMA Engine: input buffer 0 base address, high word. [access=rw]</description>
          <addressOffset>0x3044</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>IDMA_BUF_ADDR0_HI</name>
              <description>Input Buffer 0 Address, High Word
Bits [63:32] of the DDR address. [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>IDMA_BUF_ADDR_L1</name>
          <description>DMA Engine: input buffer 1 base address, low word. [access=rw]</description>
          <addressOffset>0x3048</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>IDMA_BUF_ADDR1_LO</name>
              <description>Input Buffer 1 Address, Low Word
Bits [31:0] of the DDR address of the buffer's first pixel.
Offsetting this within a larger image, together with IDMA_STRIDE, is how a crop window is expressed. [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>IDMA_BUF_ADDR_H1</name>
          <description>DMA Engine: input buffer 1 base address, high word. [access=rw]</description>
          <addressOffset>0x304c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>IDMA_BUF_ADDR1_HI</name>
              <description>Input Buffer 1 Address, High Word
Bits [63:32] of the DDR address. [access=rw]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>IDMA_BUF_ADDR_L2</name>
          <description>DMA Engine: input buffer 2 base address, low word. [access=rw]</description>
          <addressOffset>0x3050</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>IDMA_BUF_ADDR2_LO</name>
              <description>Input Buffer 2 Address, Low Word

mainmenu "neon-mdf Configuration"

# Like ESP-IDF's original Kconfig: this file specifies the Kconfig source of each "component" (here
# neon-mdf has exactly one components/driver component) - see ARCHITECTURE.md entry 11.
rsource "components/driver/Kconfig"

# Kconfig OF OWN APP (if any) - merged into GENERAL 1 menuconfig/1 sdkconfig with SDK options above.
# osource = "optional source" (same as Make's `-include`) - NO error if the app does not have its
# own Kconfig file, old behavior remains 100%. That $(NEON_MDF_APP_KCONFIG) cmake/kconfig.cmake set
# itself = <APP_DIR>/Kconfig - see comment there. Real example:
# Projects/Examples/Blinky/Kconfig.
osource "$(NEON_MDF_APP_KCONFIG)"

menu "FTEL FX1 camera stack"

rsource "components/neon_camera_runtime/Kconfig"

endmenu
